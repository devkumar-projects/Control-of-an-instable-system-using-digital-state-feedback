<ModelInformation Version="1.0">
  <Model>
    <P Name="ModelUUID">30a36495-77ac-45f8-85a9-6364c4e3d67a</P>
    <P Name="PostLoadFcn">, if any(exist(&apos;dsrtsu_mdlpostloadfcn&apos;, &apos;file&apos;) == [2, 3, 6]), try dsrtsu_mdlpostloadfcn(&apos;Execute&apos;, bdroot); catch fprintf(&apos;Error in PostLoadFcn (dsrtsu_mdlpostloadfcn) for model &quot;%s&quot;:\n %s\n&apos;, bdroot, lasterr); end, end, 
</P>
    <P Name="LastSavedArchitecture">win64</P>
    <UserParameters>
      <P Name="DSRTSU_INTERNAL_RTI_VER">370</P>
      <P Name="DSRTSU_INTERNAL_RTI_TYPE">rti1104</P>
    </UserParameters>
